PORT=5000
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dct
DB_USER=root
DB_PASSWORD=

# Hosting mailbox SMTP settings. Check cPanel/hosting mail client settings if these differ.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@digitalcrowdtech.in
SMTP_PASS=your_hosting_mail_password_here

# Optional. Defaults to SMTP_USER and support@digitalcrowdtech.in.
SMTP_FROM=support@digitalcrowdtech.in
CONTACT_TO_EMAIL=support@digitalcrowdtech.in

# Frontend admin login.
ADMIN_EMAIL=admin@digitalcrowdtech.in
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=change_this_to_a_long_random_secret
