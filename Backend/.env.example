PORT=5001
NODE_ENV=production
CORS_ORIGIN=https://digitalcrowdtech.in,https://www.digitalcrowdtech.in,https://dskirana.in,https://www.dskirana.in,https://api.dskirana.in

# Database credentials (use least-privileged application user in production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dct
DB_USER=dct_app_user
DB_PASSWORD=your_strong_db_password

# Authentication & Security
JWT_SECRET=your_super_strong_random_jwt_secret_min_32_characters
ADMIN_EMAIL=admin@digitalcrowdtech.in
ADMIN_PASSWORD=your_strong_admin_initial_password

# Mailbox SMTP settings for customer contact form notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@digitalcrowdtech.in
SMTP_PASS=your_hosting_mail_password
SMTP_FROM=support@digitalcrowdtech.in
CONTACT_TO_EMAIL=support@digitalcrowdtech.in
